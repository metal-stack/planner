{
  "name": "metal-stack-planner",
  "private": true,
  "version": "0.0.0",
  "description": "Plan a metal-stack installation in the browser: networks, topology, rack elevations and an orderable hardware BOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metal-stack/planner.git"
  },
  "bugs": {
    "url": "https://github.com/metal-stack/planner/issues"
  },
  "homepage": "https://metal-stack.github.io/planner/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
